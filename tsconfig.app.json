{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",

    "jsx": "react-jsx",

    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,

    "types": ["vite/client"],

    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "paths": {
      "@/*": ["app/*"]
    }
  },

  "include": [
    "src",
    "app",
    "src/**/*.d.ts"
  ]
}